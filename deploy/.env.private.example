# Private-deployment env template.
# Copy to deploy/.env.private and fill in before running the private overlay.

# REQUIRED. Daemon API token. Generate with: openssl rand -hex 32
OD_API_TOKEN=

# Prebuilt private image (OpenCode-enabled). Pull this tag on the server
# instead of building in place. Use whatever registry you publish to.
OPEN_DESIGN_PRIVATE_IMAGE=your-registry.example.com/your-namespace/open-design:private

# Base image tag consumed by deploy/Dockerfile.private when you build locally.
OPEN_DESIGN_BASE_IMAGE=open-design:base

# Pin OpenCode for reproducible images.
OPENCODE_VERSION=latest

# Fresh private deployments default to OpenCode and the local Qwen model.
OPEN_DESIGN_DEFAULT_AGENT_ID=opencode
OPEN_DESIGN_DEFAULT_AGENT_MODEL=local-qwen36/qwen3.6-35b-a3b-fp8

# Host port exposed on 127.0.0.1. Front with an authenticated reverse proxy.
OPEN_DESIGN_PORT=7456

# Browser origins allowed to call /api when behind a domain / reverse proxy,
# e.g. https://od.internal.example.com
OPEN_DESIGN_ALLOWED_ORIGINS=

# Container memory / heap caps.
OPEN_DESIGN_MEM_LIMIT=384m
NODE_OPTIONS=--max-old-space-size=192

# Leave the following UNSET / empty in private deployments. They are listed
# here only to document that the private overlay blanks them; setting them has
# no effect because OPEN_DESIGN_PRIVATE_DEPLOYMENT=1 ignores telemetry config.
# POSTHOG_KEY=
# POSTHOG_HOST=
# OPEN_DESIGN_TELEMETRY_RELAY_URL=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
