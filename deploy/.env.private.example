# Private-deployment env template.
# Copy to deploy/.env.private and fill in before running the private overlay.

# REQUIRED. Daemon API token. Generate with: openssl rand -hex 32
OD_API_TOKEN=

# Prebuilt private image (OpenCode-enabled). Pull this tag on the server
# instead of building in place. Use whatever registry you publish to.
OPEN_DESIGN_PRIVATE_IMAGE=your-registry.example.com/your-namespace/open-design:private

# Base image tag consumed by deploy/Dockerfile.private when you build locally.
# Defaults to the ACR `:base` moving tag; override with a versioned tag
# (e.g. ...:base-0.10.0) if your registry only publishes versioned base images.
OPEN_DESIGN_BASE_IMAGE=crpi-sxza8grrzyp8e6zm.cn-shanghai.personal.cr.aliyuncs.com/shpt/open-design:base

# Pin OpenCode for reproducible images.
OPENCODE_VERSION=latest

# Fresh private deployments default to OpenCode and the local Qwen model.
# Set OPEN_DESIGN_DEFAULT_AGENT_ID=cursor-agent to default to the Cursor CLI
# instead (only meaningful with the agents overlay below). Either way both
# agents stay selectable in the UI when the agents image is used.
OPEN_DESIGN_DEFAULT_AGENT_ID=opencode
OPEN_DESIGN_DEFAULT_AGENT_MODEL=local-qwen36/qwen3.6-35b-a3b-fp8

# --- Multi-agent (OpenCode + Cursor CLI) overlay ---------------------------
# Only used when you add deploy/docker-compose.agents.yml to the -f chain.
# That image bundles BOTH opencode and the Cursor CLI so users can choose
# either at run time. NOTE: cursor-agent is NOT offline — it routes through
# Cursor's cloud (api2.cursor.sh).
#
# Prebuilt multi-agent image tag (built from deploy/Dockerfile.agents).
OPEN_DESIGN_AGENTS_IMAGE=your-registry.example.com/your-namespace/open-design:agents
# Base image consumed by deploy/Dockerfile.agents when you build locally.
# Defaults to the ACR `:private` moving tag; override with a versioned tag if
# your registry only publishes versioned private images.
OPEN_DESIGN_AGENTS_BASE_IMAGE=crpi-sxza8grrzyp8e6zm.cn-shanghai.personal.cr.aliyuncs.com/shpt/open-design:private
# Cursor CLI credential for headless use. Generate a User API key from
# Cursor Dashboard -> API Keys (a Service Account key works too and is
# preferred for team/CI). Leave blank to keep cursor-agent unauthenticated.
CURSOR_API_KEY=

# Host port exposed on 127.0.0.1. Front with an authenticated reverse proxy.
OPEN_DESIGN_PORT=7456

# Browser origins allowed to call /api when behind a domain / reverse proxy,
# e.g. https://od.internal.example.com
OPEN_DESIGN_ALLOWED_ORIGINS=

# Container memory / heap caps.
OPEN_DESIGN_MEM_LIMIT=384m
NODE_OPTIONS=--max-old-space-size=192

# Leave the following UNSET / empty in private deployments. They are listed
# here only to document that the private overlay blanks them; setting them has
# no effect because OPEN_DESIGN_PRIVATE_DEPLOYMENT=1 ignores telemetry config.
# POSTHOG_KEY=
# POSTHOG_HOST=
# OPEN_DESIGN_TELEMETRY_RELAY_URL=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
